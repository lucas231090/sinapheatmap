# Backend Environment Variables
PORT=3333
MONGO_URL=mongodb://root:senha123@mongodb:27017/sinapheatmap?authSource=admin
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
NODE_ENV=production

# CORS: origens que podem acessar a API (separe por vírgula para múltiplas)
# Em desenvolvimento local use: http://localhost:3000
# Em produção use o domínio real: https://seuapp.com
ALLOWED_ORIGINS=http://localhost:3000

# MongoDB Environment Variables
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=senha123
MONGO_INITDB_DATABASE=sinapheatmap

# Frontend Environment Variables
# URL que o NAVEGADOR usa para acessar a API
# Em desenvolvimento local: http://localhost:3333
# Em produção: https://api.seudominio.com
VITE_API_BASE_URL=http://localhost:3333
